    "reproduction_python": "from pathlib import Path\nimport csv, json, numpy as np\nroot = Path(\"/home/yujun/program/hermes\")\ntraces = root / \"results/myobservations/lu_kv_offline_50v_20260913\"\nmanifest = json.loads((traces / \"manifest.json\").read_text())\nhalf = json.loads((root / \"data/streamingbench/streamingbench_realtime_half_userpaths.json\").read_text())\ncalib = {str(v[\"video_id\"]) for v in manifest[\"videos\"]}\neval_ids = {str(v[\"video_id\"]) for v in half}\ncalib_names = {Path(v[\"video_path\"]).name for v in manifest[\"videos\"]}\neval_names = {Path(v[\"video_path\"]).name for v in half}\neligible, observations = set(), 0\nfor p in sorted(traces.glob(\"v*_q*.npz\")):\n    with np.load(p) as z:\n        times = z[\"source_times\"]\n    units = np.unique(times)\n    if len(units) < 2:\n        continue\n    start = int(np.searchsorted(times, units[-2], side=\"left\"))\n    if len(times) - start < 512 or start < 1472:\n        continue\n    eligible.add(p.stem.split(\"_\")[0][1:])\n    observations += 1\nprint(len(calib), len(calib & eval_ids), len(calib_names & eval_names))  # 50, 0, 0\nprint(len(eligible), observations, len(eligible & eval_ids))  # 48, 68, 0\nfor k in (100, 250, 500, 1000):\n    for p in (root / \"results/qwen2.5_vl_7b/streamingbench\").glob(f\"*kv{k}-*dp-cachecomp*/results.csv\"):\n        rows = list(csv.DictReader(p.open()))\n        vids = {str(r[\"video_id\"]) for r in rows}\n        print(k, len(rows), len(vids), len(calib & vids), len(eligible & vids), vids <= eval_ids)\n# 100/250/500: 754, 150, 0, 0, True; 1000: 1255, 250, 0, 0, True\n",
